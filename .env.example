# Copy to .env and fill in real values locally. Never commit .env.
# This file documents variable NAMES only — no real secrets.

# --- Triage provider selection ---
# One of: llm | rules | simulated
TRIAGE_PROVIDER=simulated

# --- Hosted LLM (Groq) — required only when TRIAGE_PROVIDER=llm ---
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-20b

# --- Database ---
DATABASE_URL=postgresql+psycopg://civicpulse:civicpulse@localhost:5432/civicpulse

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Backend runtime ---
BACKEND_PORT=8000
LOG_LEVEL=INFO

# --- Rate limiter ---
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# --- Cache TTLs (seconds) ---
STATS_CACHE_TTL_SECONDS=30
TRIAGE_CACHE_TTL_SECONDS=86400
