# Copy to .env and fill in real values locally. Never commit .env.
# This file documents variable NAMES only — no real secrets.

# --- Triage provider selection ---
# One of: llm | rules | simulated
TRIAGE_PROVIDER=simulated

# --- Hosted LLM (Groq) — required only when TRIAGE_PROVIDER=llm ---
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-20b

# --- Database ---
# Used directly by `uv run uvicorn ...` (native, non-Docker dev).
DATABASE_URL=postgresql+psycopg://civicpulse:civicpulse@localhost:5432/civicpulse

# --- Redis ---
# Used directly by `uv run uvicorn ...` (native, non-Docker dev).
REDIS_URL=redis://localhost:6379/0

# --- Docker Compose: PostgreSQL container credentials ---
# Consumed by compose.yaml/compose.prod.yaml to configure the `postgres`
# service and to build the in-container DATABASE_URL (which points at the
# `postgres` service hostname, not localhost).
POSTGRES_USER=civicpulse
POSTGRES_PASSWORD=civicpulse
POSTGRES_DB=civicpulse

# --- Docker Compose (production only): immutable image references ---
# IMAGE_TAG must be a commit SHA, never `latest` — see docs/adr/0003-deploy-by-sha.md.
BACKEND_IMAGE=civicpulse-backend
FRONTEND_IMAGE=civicpulse-frontend
IMAGE_TAG=

# --- Backend runtime ---
BACKEND_PORT=8000
LOG_LEVEL=INFO

# --- Rate limiter ---
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# --- Cache TTLs (seconds) ---
STATS_CACHE_TTL_SECONDS=30
TRIAGE_CACHE_TTL_SECONDS=86400
